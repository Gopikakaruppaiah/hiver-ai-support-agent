# Copy this file to .env and fill in values. Never commit the real .env.

# --- Brand / scope ---
BRAND_NAME=Uber_Support

# --- Data paths (defaults assume repo-relative layout) ---
DATA_RAW_PATH=data/raw/twcs.csv
DATA_PROCESSED_DIR=data/processed
DATA_GOLDEN_DIR=data/golden
MODELS_DIR=models

# --- Reproducibility ---
RANDOM_SEED=42
GOLDEN_POOL_SIZE=300
GOLDEN_EVAL_SIZE=200

# --- LLM API (leave blank to run in DEMO MODE with no live LLM calls) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_NAME=
